{
  "name": "riverbay-portfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:start": "node scripts/start-local.mjs",
    "setup:local": "node scripts/setup-local.mjs",
    "test:access": "node --env-file=.env.local scripts/check-access.mjs",
    "test:directory": "node --env-file=.env.local scripts/check-directory.mjs",
    "test:teacher-setup": "node --experimental-strip-types --conditions=react-server --env-file=.env.local scripts/check-teacher-setup.mjs"
  },
  "dependencies": {
    "@daypicker/react": "10.0.2",
    "@fontsource-variable/noto-sans-sc": "5.3.1",
    "@fontsource-variable/nunito": "5.3.0",
    "@sparticuz/chromium": "153.0.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "driver.js": "1.10.2",
    "motion": "14.3.1",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "supabase": "^2.121.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
