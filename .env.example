NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only; required for Add teacher. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only; GPT drafting. Never use NEXT_PUBLIC_ for the API key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini-2025-04-14
# Set explicitly when multiple providers have keys: gemini, groq or openai.
# If blank, selects Gemini when its key exists, then Groq, otherwise OpenAI.
AI_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Public build setting: bump ONLY this value to replay tour introductions on deployment.
# Does not reset database seeds, accounts, portfolios, files or navigation memory.
NEXT_PUBLIC_TOUR_ONBOARDING_VERSION=1
