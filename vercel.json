{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "sin1"
  ],
  "crons": [
    {
      "path": "/api/guest/reset",
      "schedule": "0 19 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(benchmarks|pdf-template)/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
